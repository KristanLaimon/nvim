-- Test 08: Complex Recursive Algorithms and Math
function fib(n)
  if n <= 1 then
    return n
  end
  return fib(n - 1) + fib(n - 2)
end

local res = fib(6)
print("Fibonacci of 6:", res)

function is_even(num)
  if num == 0 then
    return true
  end
  return is_even(num - 1)
end

print("Algorithm tests finished.")
