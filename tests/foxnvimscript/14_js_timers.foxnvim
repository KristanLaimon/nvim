-- 14_js_timers.foxnvim: JavaScript-style Timers (setTimeout, clearTimeout, setInterval, clearInterval)
local async = import("async")

print("=== Starting JS Timers Transpilation Test ===")

local timer_started = true
print("Timer system initialized:", timer_started)

local function on_timeout()
	print("setTimeout callback executed")
end

local t_id = setTimeout(on_timeout, 10)

local function on_cancelled()
	print("This should NOT print")
end

local c_id = setTimeout(on_cancelled, 20)
clearTimeout(c_id)

local count = 0
local function on_interval()
	count = count + 1
	print("setInterval tick:", count)
end

local i_id = setInterval(on_interval, 15)
clearInterval(i_id)

async.sleep(50)

print("JS Timers test completed cleanly")
print("=== JS Timers Transpilation Test Completed ===")
