-- 11_async.foxnvim: Real Promises, Heavy OS Threads, and Concurrent Multitasks
local async = import("async")

print("=== Starting Real Async & Multitask Transpilation Test ===")

local task_a = "Async Task A"
local task_b = "Async Task B"

print("Task A:", task_a)
print("Task B:", task_b)

async.sleep(50)
print("Sleep delay complete.")

local sum = 0
for i = 1, 5 do
	sum = sum + i
end
print("Heavy loop sum:", sum)

local ch = async.channel()
ch:send("Parallel message payload")
local msg = ch:receive()
print("Channel payload:", msg)

print("=== Real Async & Multitask Transpilation Test Completed ===")
