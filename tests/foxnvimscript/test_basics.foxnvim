-- Basics test script for foxnvimscript
print("Starting test script...")

local test_dir = "tests/foxnvimscript/output_test"

if not fs.exists(test_dir) then
    fs.mkdir(test_dir)
end

local sample_file = test_dir .. "/sample.txt"
fs.write(sample_file, "Hello from foxnvimscript transpiler!")

if fs.exists(sample_file) then
    print("Sample file created successfully.")
end

local content = fs.read(sample_file)
print("File content:", content)

function greet(name)
    print("Greeting:", name)
end

greet("World")

for i = 1, 3 do
    print("Loop index:", i)
end

local count = 0
while count < 3 do
    count = count + 1
    print("While count:", count)
end

print("Test script completed.")
