-- 01_basics.foxnvim: Variables, strings, numbers, concats, assignments
local name = "FOX"
local version = 2.0
local active = true

print("Name:", name)
print("Version:", version)
print("Active:", active)

local greeting = "Hello, " .. name .. " script!"
print(greeting)

name = "FOX-Updated"
version = version + 0.5
print("Updated Name:", name)
print("Updated Version:", version)

local a = 15
local b = 5
local sum = a + b
local diff = a - b
local prod = a * b

print("Sum:", sum)
print("Diff:", diff)
print("Prod:", prod)
