-- 03_loops.foxnvim: For, while, and ipairs loops
print("Numeric For Loop:")
for i = 1, 3 do
    print("i =", i)
end

print("Stepped For Loop:")
for j = 2, 6, 2 do
    print("j =", j)
end

local limit = 4
print("Variable Bound Loop:")
for k = 1, limit do
    print("k =", k)
end

print("While Loop:")
local counter = 1
while counter <= 3 do
    print("counter =", counter)
    counter = counter + 1
end

print("Ipairs Loop:")
local items = { "first", "second", "third" }
for _, item in ipairs(items) do
    print("Item:", item)
end
